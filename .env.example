# STEG backend — environment template (Phase A14).
# Copy to `.env` and fill in the blanks: `cp .env.example .env`.
# This file is TRACKED and must NEVER contain real secrets — only empty slots
# and harmless local defaults. Real values live in your untracked `.env` (or
# in secret management for shared environments).

# --- Required secrets (compose FAILS FAST if these are empty) ---
# Database password for the compose PostgreSQL service AND the backend.
SPRING_DATASOURCE_PASSWORD=
# High-entropy 256-bit+ JWT signing key (64+ random chars). Generate with:
#   openssl rand -hex 64
STEG_JWT_SECRET=

# --- Database (compose overrides the host with the `postgres` service) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/steg_db
SPRING_DATASOURCE_USERNAME=postgres
POSTGRES_DB=stegdb
POSTGRES_PORT=5432
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# --- App ---
SPRING_PROFILES_ACTIVE=local
APP_PORT=8080
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=7
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# --- File storage / malware scan (local dev) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads
MALWARE_MODE=noop

# --- AI (disabled unless enabled with a real key) ---
AI_ENABLED=false
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_TIMEOUT_MS=10000
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2

# --- Mail (local dev default: MailHog-style relay on :1025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
