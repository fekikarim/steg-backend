# ─────────────────────────────────────────────────────────────────────────────
# STEG Backend — Environment Configuration Template
# Copy to `.env` and fill in the required values.
# This file is TRACKED and must NEVER contain real secrets — only placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED SECRETS (application fails fast if empty) ────────────────────────
# Database password for PostgreSQL service AND Spring datasource
SPRING_DATASOURCE_PASSWORD=

# JWT signing key: high-entropy 256-bit+ string (64+ random hex characters)
# Generate with: openssl rand -hex 32
STEG_JWT_SECRET=

# ── Database Configuration ─────────────────────────────────────────────────────
# JDBC URL format: jdbc:postgresql://[host]:[port]/[dbname]
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/steg_db
SPRING_DATASOURCE_USERNAME=postgres

# Connection pool sizing
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ── Application ────────────────────────────────────────────────────────────────
# Active Spring profiles: local (dev/debug), integration (seeded demo data, E0.4),
# clean (migrations only, empty DB, E0.4), test (Testcontainers), prod (hardened)
SPRING_PROFILES_ACTIVE=local

# Demo seeding (integration profile ONLY; ignored on clean/prod).
# OFF by default and there is NO default password: demo accounts
# *@demo.steg.tn are fictional, and a shared environment must never be seeded
# with credentials that live in this repository. The seeder fails fast when it
# is switched on without an explicit password.
STEG_SEED_DEMO_ENABLED=false
# Set only for a local/integration run whose password you chose yourself:
# STEG_SEED_DEMO_PASSWORD=

# Server port
APP_PORT=8080

# JWT token expiration (in minutes for access, days for refresh)
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_DAYS=7

# Account lockout after failed login attempts
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ── CORS Configuration ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcard with credentials)
# Local: http://localhost:3000,http://localhost:4200
# Production: https://app.steg.tn,https://admin.steg.tn
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ── File Storage ───────────────────────────────────────────────────────────────
# Provider: "local" (filesystem) or "s3" (AWS S3)
# For local: directory path where uploaded documents are stored
# For S3: bucket name and region configured separately
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads

# ── Malware Detection ──────────────────────────────────────────────────────────
# Mode: "noop" (disabled), "clamav" (external), "yara" (rules-based)
# Production: "clamav" — unscanned uploads must not be accepted.
MALWARE_MODE=noop
# clamd endpoint (docker-compose service name, host:port)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Per-scan timeout; uploads are REFUSED (fail-closed) when clamd is unreachable
# and MALWARE_ON_ERROR=reject.
MALWARE_TIMEOUT_MILLIS=10000
MALWARE_MAX_SCAN_BYTES=26214400
# reject = fail-closed (default) | allow = fail-open emergency degraded mode
MALWARE_ON_ERROR=reject

# ── First-run admin (production) ────────────────────────────────────────────────
# Set BOTH exactly once, on a database where no Admin exists. The backend then
# creates ONE Admin account with a forced password change and never-op after
# that. Leave empty afterwards and remove them from .env.
# Password rules: >= 12 characters with uppercase, lowercase, digit and symbol.
STEG_BOOTSTRAP_ADMIN_EMAIL=
STEG_BOOTSTRAP_ADMIN_PASSWORD=

# ── AI / Gemini Configuration (disabled by default) ────────────────────────────
# Enable AI features (Logbook generation, document analysis, chatbot)
AI_ENABLED=false

# AI provider: "gemini" (Google AI), "anthropic" (Claude), "openai" (GPT)
AI_PROVIDER=gemini

# API key: obtained from provider console. NEVER commit real keys here.
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# (Deprecated) Use GEMINI_API_KEY above instead
AI_API_KEY=

# Model name for the chosen provider (backend-only, never exposed to clients).
# There is NO hard-coded default: AI_MODEL wins, then GEMINI_MODEL, then blank
# (= "AI unavailable" degraded mode — core flows keep working).
# Gemini: gemini-2.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=

# (Optional override) Takes precedence over GEMINI_MODEL when set.
AI_MODEL=

# Provider API base URL (usually default, override for proxies)
AI_BASE_URL=https://generativelanguage.googleapis.com

# AI request timeout in milliseconds
AI_TIMEOUT_MS=10000

# Optional generation parameters
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2

# ── Email / Resend (transactional) ───────────────────────────────────────────
# Resend REST API (https://api.resend.com/emails) — backend-only, API key never
# leaves the server (never commit, never expose to frontend/mobile).
# Obtain from https://resend.com/api-keys (re_...). For local dev without
# sending, leave empty and keep NOTIFICATIONS_MAIL_ENABLED=false.
RESEND_API_KEY=

# Notifications — email channel (Resend) — disabled by default in dev
# Set to true to enable transactional emails (e.g. application confirmation).
# Both variables are required for Resend to be used; the sender must be a
# verified domain in Resend (e.g. no-reply@steg.tn). Empty values keep the
# application in degraded mode: workflows complete, mail is reported unsent.
NOTIFICATIONS_MAIL_ENABLED=false
NOTIFICATIONS_MAIL_FROM=

# ── External Services ──────────────────────────────────────────────────────────
# Python AI document services (FastAPI, backend-only callers via shared token).
# Empty values = AI degraded mode (workflows continue, "AI unavailable" surfaced).
PYTHON_AI_SERVICE_BASE_URL=http://localhost:8000
PYTHON_AI_SERVICE_TOKEN=
PYTHON_AI_TIMEOUT_MS=15000
PYTHON_AI_MAX_ATTEMPTS=2
# Consecutive failures before the python-ai adapter opens its circuit
PYTHON_AI_CIRCUIT_THRESHOLD=5

# Push notification provider (FCM, OneSignal, etc.)
# PUSH_PROVIDER_KEY=

# ── Logging & Observability ────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Correlation ID header name (for tracing across services)
CORRELATION_ID_HEADER=X-Correlation-ID

# ── Timezone & Localization ──────────────────────────────────────────────────
# Application time zone for every calendar-day date-range filter
# (candidates, applications, audit, notifications). Backend stores UTC
# instants; day boundaries resolve in this zone. Read as steg.timezone.
APP_TIMEZONE=Africa/Tunis
